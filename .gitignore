# Ignorar todo por defecto
*

# Permitir las carpetas que queremos versionar y su contenido
!/.github/
!/.github/**
!/.cursor/
!/.cursor/**
!/docs/
!/docs/**
!/docs/assets/
!/docs/assets/**
!/.agents/
!/.agents/**
!/homework/
!/homework/**
!/planning/
!/planning/**

# Inventarios versionados; los materiales internos continúan siendo locales
!/reference/
!/reference/README.md
!/course-admin/
!/course-admin/README.md

# Permitir archivos de Quarto (.qmd, .bib, .scss, imágenes)
!/quarto/
!/quarto/**/
!/quarto/**/*.qmd
!/quarto/**/*.bib
!/quarto/**/*.scss
!/quarto/**/*.png
!/quarto/**/*.jpg
!/quarto/**/*.jpeg
!/quarto/**/*.svg

# Permitir archivos específicos en la raíz
!/.gitignore
!/index.html
!/README.md
!/AGENTS.md
!/CONTRIBUTING.md
!/CLAUDE.md
!/GEMINI.md
!/llms.txt
!/LICENSE

# Ignorar archivos temporales y generados (al final para que tengan prioridad sobre los whitelists)
**/.quarto/
**/.quarto/**
**/*_files/
**/*_files/**
**/.ipynb_checkpoints/
**/.ipynb_checkpoints/**
**/__pycache__/
**/__pycache__/**
**/*.pyc
**/*.pyo
quarto/**/assets/

# Recursos reproducibles de la presentacion de clustering
!quarto/clustering/generate_figures.py
!quarto/clustering/country_narrative.py
!quarto/clustering/requirements.txt
!quarto/clustering/data/
!quarto/clustering/data/Country-data.csv
!quarto/clustering/assets/
quarto/clustering/assets/*
!quarto/clustering/assets/generated/
!quarto/clustering/assets/generated/**
